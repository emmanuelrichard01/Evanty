# ─────────────────────────────────────────────
# Evanty — Environment Variables
# Copy to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Clerk Authentication ────────────────────
# Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# These control redirect behaviour — don't change unless you rename the routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Database (Neon PostgreSQL) ──────────────
# Use the POOLED connection string for the app (PgBouncer)
# Use the DIRECT connection string only for drizzle-kit migrate
DATABASE_URL=postgresql://user:password@ep-xxx.pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── Stripe ──────────────────────────────────
# Dashboard → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Paystack ────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# ─── Cloudflare R2 ───────────────────────────
# Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_API_TOKEN=your_r2_api_token
R2_BUCKET_NAME=evanty-uploads
# Public CDN/R2 Dev subdomain URL for your R2 bucket
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your_public_id.r2.dev

# ─── Upstash Redis (BullMQ queue) ────────────
# console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Resend (transactional email) ────────────
# resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=tickets@yourdomain.com

# ─── Sentry ──────────────────────────────────
# sentry.io → your project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=evanty
SENTRY_AUTH_TOKEN=...

# ─── Axiom (structured logging) ──────────────
# axiom.co → Settings → API Tokens
AXIOM_DATASET=evanty-logs
AXIOM_TOKEN=...

# ─── QR code signing ─────────────────────────
# Generate a random 32-byte secret: openssl rand -hex 32
QR_SIGNING_SECRET=...
